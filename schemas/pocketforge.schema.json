{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlexandreGSilva07/Pocket-forge/blob/main/schemas/pocketforge.schema.json",
  "title": "PocketForge Project Manifest",
  "description": "Contrato declarativo de requisitos, não gerador automático de gameplay.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "target", "genre", "input", "visual", "budgets", "states", "assets", "acceptance"],
  "properties": {
    "schemaVersion": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 100},
    "target": {
      "type": "object", "required": ["platform", "orientation"],
      "additionalProperties": false,
      "properties": {
        "platform": {"enum": ["web", "desktop-web", "mobile-web"]},
        "orientation": {"enum": ["responsive", "landscape", "portrait"]}
      }
    },
    "genre": {"type": "string", "minLength": 1},
    "input": {"type": "array", "uniqueItems": true, "minItems": 1, "items": {"enum": ["keyboard", "touch", "mouse", "gamepad"]}},
    "visual": {
      "type": "object", "required": ["style", "motion"], "additionalProperties": false,
      "properties": {
        "style": {"type": "string", "minLength": 1},
        "motion": {"enum": ["reduced-supported", "default-only", "minimal"]}
      }
    },
    "budgets": {
      "type": "object", "required": ["transferBytes", "targetFps"], "additionalProperties": false,
      "properties": {
        "transferBytes": {"type": "integer", "minimum": 1},
        "targetFps": {"type": "integer", "minimum": 15, "maximum": 240}
      }
    },
    "states": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "assets": {"type": "array", "items": {"type": "object"}},
    "acceptance": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
  }
}
